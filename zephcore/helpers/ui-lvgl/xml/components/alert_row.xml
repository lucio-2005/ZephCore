<!-- One entry on the Alerts screen. -->
<component>
    <api>
        <prop name="level" type="string" default="ERROR"/>
        <prop name="tint" type="color" default="0xef4444"/>
        <prop name="source" type="string" default=""/>
        <prop name="message" type="string" default=""/>
        <prop name="meta" type="string" default=""/>
    </api>

    <view extends="lv_obj" width="100%" height="content" flex_flow="column" scrollable="false" clickable="false"
          style_border_side="left" style_border_width="3" style_border_color="$tint" style_pad_row="2">
        <style name="style_row"/>
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                style_pad_column="6" style_flex_cross_place="center">
            <style name="style_plain"/>
            <lv_label text="$level" style_text_color="$tint" style_bg_color="$tint">
                <style name="style_tag"/>
            </lv_label>
            <lv_label text="$source" flex_grow="1" height="15" long_mode="dots">
                <style name="style_text_muted"/>
            </lv_label>
            <lv_label text="$meta">
                <style name="style_text_muted"/>
            </lv_label>
        </lv_obj>
        <lv_label text="$message" width="100%"/>
    </view>
</component>
