<!-- Remote console: CLI commands to the node logged in to, and its replies.
     The device opens it on the top layer over the remote screen. -->
<component>
    <view extends="lv_obj" width="100%" height="100%" flex_flow="column" scrollable="false"
          style_pad_row="0">
        <style name="style_screen"/>
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                style_pad_ver="4" style_pad_hor="4">
            <style name="style_statusbar"/>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_console_close"/>
                <lv_label text="Close" style_text_font="font_small"/>
            </lv_button>
            <lv_label bind_text="remote_name" flex_grow="1" height="20" long_mode="dots">
                <style name="style_title"/>
            </lv_label>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_accent"/>
                <style name="style_btn_accent_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_console_send"/>
                <lv_label text="Send" style_text_font="font_small"/>
            </lv_button>
        </lv_obj>
        <lv_obj name="console_list" width="100%" flex_grow="1" flex_flow="column" scrollbar_mode="auto">
            <style name="style_page"/>
            <console_entry cmd="&gt; get name" reply="&gt; Monte Cavo"/>
            <console_entry cmd="&gt; ver" reply="v1.9.0 (Build: 12-Oct-2026)"/>
        </lv_obj>
        <lv_obj width="100%" height="content" scrollable="false" clickable="false" style_pad_all="4">
            <style name="style_plain"/>
            <lv_textarea name="console_input" width="100%" one_line="true">
                <style name="style_textarea"/>
                <style name="style_textarea_focused" selector="focused"/>
            </lv_textarea>
        </lv_obj>
        <lv_keyboard name="console_kbd" width="100%" height="45%" mode="text_lower">
            <style name="style_keyboard"/>
            <style name="style_keyboard_keys" selector="items"/>
            <style name="style_keyboard_ctrl" selector="items|checked"/>
        </lv_keyboard>
    </view>
</component>
