<!-- One node in the Contacts list: companion (CHAT), repeater (RPT), room server (ROOM) or
     sensor (SENSOR). Tapping it opens a chat, or remote management (ui_on_contact_open). -->
<component>
    <api>
        <prop name="name" type="string" default="Node"/>
        <prop name="letter" type="string" default="?"/>
        <prop name="kind" type="string" default="CHAT"/>
        <prop name="tint" type="color" default="0x2dd4bf"/>
        <prop name="heard" type="string" default=""/>
        <prop name="hops" type="string" default="Direct"/>
        <prop name="snr" type="string" default=""/>
    </api>

    <view extends="lv_button" width="100%" height="content" flex_flow="row" scrollable="false">
        <style name="style_row"/>
        <style name="style_row_pressed" selector="pressed"/>
        <event_cb trigger="clicked" callback="ui_on_contact_open"/>

        <avatar letter="$letter" tint="$tint"/>

        <lv_obj flex_grow="1" height="content" flex_flow="column" clickable="false" scrollable="false">
            <style name="style_plain"/>
            <lv_obj width="100%" height="content" flex_flow="row" clickable="false" scrollable="false"
                    style_pad_column="6" style_flex_cross_place="center">
                <style name="style_plain"/>
                <lv_label text="$name" height="20" long_mode="dots" style_max_width="70%">
                    <style name="style_title"/>
                </lv_label>
                <lv_label text="$kind" style_text_color="$tint" style_bg_color="$tint">
                    <style name="style_tag"/>
                </lv_label>
            </lv_obj>
            <lv_label text="$heard">
                <style name="style_text_muted"/>
            </lv_label>
        </lv_obj>

        <lv_obj width="content" height="content" flex_flow="column" clickable="false" scrollable="false"
                style_flex_cross_place="end">
            <style name="style_plain"/>
            <lv_label text="$hops" style_text_font="font_small"/>
            <lv_label text="$snr">
                <style name="style_text_muted"/>
            </lv_label>
        </lv_obj>
    </view>
</component>
