<!-- Text entry for one setting. The device creates it on the top layer, fills the
     text area and keyboard mode, and removes it on Cancel or a successful Save. -->
<component>
    <view extends="lv_obj" width="100%" height="100%" flex_flow="column" scrollable="false"
          style_pad_row="0">
        <style name="style_screen"/>
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                style_pad_ver="4" style_pad_hor="4">
            <style name="style_statusbar"/>
            <lv_button name="panel_close" width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_edit_cancel"/>
                <lv_label text="Cancel" style_text_font="font_small"/>
            </lv_button>
            <lv_label bind_text="edit_title" flex_grow="1" height="20" long_mode="dots">
                <style name="style_title"/>
            </lv_label>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_accent"/>
                <style name="style_btn_accent_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_edit_save"/>
                <lv_label text="Save" style_text_font="font_small"/>
            </lv_button>
        </lv_obj>
        <lv_obj width="100%" flex_grow="1" flex_flow="column" scrollable="false" clickable="false">
            <style name="style_page"/>
            <lv_textarea name="edit_input" width="100%" one_line="true">
                <style name="style_textarea"/>
                <style name="style_textarea_focused" selector="focused"/>
            </lv_textarea>
            <lv_label bind_text="edit_hint" width="100%">
                <style name="style_text_muted"/>
            </lv_label>
        </lv_obj>
        <lv_keyboard name="edit_kbd" width="100%" height="55%" mode="text_lower">
            <style name="style_keyboard"/>
            <style name="style_keyboard_keys" selector="items"/>
            <style name="style_keyboard_ctrl" selector="items|checked"/>
            <style name="style_keyboard_sel" selector="items|focus_key"/>
        </lv_keyboard>
    </view>
</component>
