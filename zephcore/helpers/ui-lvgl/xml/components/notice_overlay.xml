<!-- Full-screen notice, e.g. the low-battery shutdown warning. -->
<component>
    <api>
        <prop name="title" type="string" default="Low battery"/>
        <prop name="detail" type="string" default="Shutting down"/>
    </api>

    <view extends="lv_obj" width="100%" height="100%" flex_flow="column" scrollable="false"
          style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
        <style name="style_overlay"/>
        <lv_label text="$title" style_text_font="font_big" style_text_color="#danger"/>
        <lv_label text="$detail"/>
    </view>
</component>
