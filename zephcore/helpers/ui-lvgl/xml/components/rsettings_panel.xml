<!-- Settings of the node logged in to as admin, read and changed with CLI
     commands. The device opens it on the top layer over the remote screen. -->
<component>
    <view extends="lv_obj" width="100%" height="100%" flex_flow="column" scrollable="false"
          style_pad_row="0">
        <style name="style_screen"/>
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                style_pad_ver="4" style_pad_hor="4">
            <style name="style_statusbar"/>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_rsettings_close"/>
                <lv_label text="Close" style_text_font="font_small"/>
            </lv_button>
            <lv_label bind_text="remote_name" flex_grow="1" height="20" long_mode="dots">
                <style name="style_title"/>
            </lv_label>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_rsettings_reload"/>
                <lv_label text="Reload" style_text_font="font_small"/>
            </lv_button>
        </lv_obj>
        <lv_obj width="100%" flex_grow="1" flex_flow="column" scrollbar_mode="auto">
            <style name="style_page"/>
            <lv_label bind_text="rs_state" width="100%">
                <style name="style_text_muted"/>
            </lv_label>
            <value_row label="Name" value="rs_name" key="r.name"/>
            <value_row label="Latitude" value="rs_lat" key="r.lat"/>
            <value_row label="Longitude" value="rs_lon" key="r.lon"/>
            <value_row label="Radio" value="rs_radio" key="r.radio"/>
            <value_row label="TX power" value="rs_tx" key="r.tx"/>
            <value_row label="Repeat" value="rs_repeat" key="r.repeat"/>
            <value_row label="Advert every" value="rs_adv" key="r.advert.interval"/>
            <value_row label="Flood advert every" value="rs_fadv" key="r.flood.advert.interval"/>
            <value_row label="Owner info" value="rs_owner" key="r.owner.info"/>
            <value_row label="Guest password" value="rs_guest" key="r.guest.password"/>
            <value_row label="Admin password" value="rs_admin" key="r.password"/>
        </lv_obj>
    </view>
</component>
