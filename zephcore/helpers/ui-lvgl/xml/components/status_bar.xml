<!-- Top bar: node name, unread count, last RSSI, battery and clock. All values come from subjects. -->
<component>
    <view extends="lv_obj" width="100%" height="26" flex_flow="row" scrollable="false" clickable="false">
        <style name="style_statusbar"/>

        <lv_label bind_text="node_name" flex_grow="1" height="20" long_mode="dots">
            <style name="style_title"/>
        </lv_label>

        <lv_button width="content" height="18">
            <style name="style_badge_btn"/>
            <style name="style_alert_warn"/>
            <bind_style name="style_alert_err" subject="alert_level" ref_value="2"/>
            <bind_flag_if_eq subject="alert_count" flag="hidden" ref_value="0"/>
            <screen_create_event trigger="clicked" screen="alerts" anim_type="move_left" duration="200"/>
            <lv_label bind_text="alert_count" bind_text-fmt="! %d" align="center" style_text_font="font_small"/>
        </lv_button>

        <lv_label bind_text="unread_total" bind_text-fmt="%d new">
            <style name="style_badge"/>
            <bind_flag_if_eq subject="unread_total" flag="hidden" ref_value="0"/>
        </lv_label>

        <lv_label bind_text="last_rssi" bind_text-fmt="%d dBm">
            <style name="style_text_muted"/>
        </lv_label>

        <lv_bar width="22" height="10" bind_value="battery_pct">
            <style name="style_track"/>
            <style name="style_indicator" selector="indicator"/>
        </lv_bar>
        <lv_label bind_text="battery_pct" bind_text-fmt="%d%%">
            <style name="style_text_muted"/>
        </lv_label>

        <lv_label bind_text="clock">
            <style name="style_text_muted"/>
        </lv_label>
    </view>
</component>
