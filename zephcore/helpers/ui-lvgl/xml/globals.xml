<globals>
    <api>
    </api>

    <consts>
        <!-- Palette (dark theme) -->
        <color name="bg"         value="0x0e1318"/>
        <color name="surface"    value="0x182028"/>
        <color name="surface2"   value="0x222c37"/>
        <color name="line"       value="0x2d3946"/>
        <color name="text"       value="0xe6edf3"/>
        <color name="muted"      value="0x8a97a6"/>
        <color name="accent"     value="0x2dd4bf"/>
        <color name="on_accent"  value="0x06201d"/>
        <color name="bubble_out" value="0x0f4f4a"/>

        <!-- Node kind colors -->
        <color name="kind_chat"    value="0x2dd4bf"/>
        <color name="kind_rpt"     value="0xf5a524"/>
        <color name="kind_room"    value="0xa78bfa"/>
        <color name="kind_channel" value="0x60a5fa"/>
        <color name="kind_sensor"  value="0xf472b6"/>

        <!-- Map without tiles -->
        <color name="map_bg"       value="0x13202b"/>
        <color name="map_line"     value="0x2a3b4a"/>

        <!-- Problems -->
        <color name="danger"     value="0xef4444"/>
        <color name="danger_bg"  value="0x3b1416"/>
        <color name="warn"       value="0xf59e0b"/>

        <!-- Spacing -->
        <px name="gap_s"  value="4"/>
        <px name="gap_m"  value="6"/>
        <px name="gap_l"  value="10"/>
        <px name="radius" value="8"/>
    </consts>

    <styles>
        <!-- Containers -->
        <style name="style_screen" bg_color="#bg" bg_opa="255" text_color="#text" text_font="font_body"
               pad_all="0" pad_row="0" border_width="0"/>
        <style name="style_plain" text_color="#text" bg_opa="0" border_width="0" pad_all="0" radius="0" shadow_width="0"
               pad_row="0" pad_column="0"/>
        <style name="style_page" text_color="#text" bg_opa="0" border_width="0" pad_all="#gap_m" pad_row="#gap_m"
               radius="0"/>
        <style name="style_card" text_color="#text" bg_color="#surface" bg_opa="255" radius="#radius" border_width="0"
               pad_all="#gap_l" pad_row="#gap_m" pad_column="#gap_m" shadow_width="0"/>

        <!-- Status bar -->
        <style name="style_statusbar" text_color="#text" bg_color="#surface" bg_opa="255" radius="0" border_width="1"
               border_side="bottom" border_color="#line" pad_hor="8" pad_ver="0" pad_column="8"
               flex_cross_place="center" flex_track_place="center"/>

        <!-- List rows -->
        <style name="style_row" text_color="#text" bg_color="#surface" bg_opa="255" radius="#radius" border_width="0"
               pad_hor="8" pad_ver="6" pad_column="8" shadow_width="0"
               flex_cross_place="center" flex_track_place="center"/>
        <style name="style_row_pressed" bg_color="#surface2"/>

        <!-- Text -->
        <style name="style_text_muted" text_color="#muted" text_font="font_small"/>
        <style name="style_title" text_font="font_title" text_color="#text"/>
        <style name="style_section" text_font="font_small" text_color="#accent" pad_top="6"/>

        <!-- Small pieces -->
        <style name="style_avatar" radius="999" bg_opa="255" border_width="0" pad_all="0"/>
        <style name="style_badge" bg_color="#accent" bg_opa="255" radius="999" pad_hor="6" pad_ver="1"
               text_color="#on_accent" text_font="font_small"/>
        <style name="style_tag" bg_opa="40" radius="4" pad_hor="4" pad_ver="0" text_font="font_small"/>

        <!-- Buttons -->
        <style name="style_btn" bg_color="#surface2" bg_opa="255" radius="6" border_width="0"
               shadow_width="0" text_color="#text" pad_hor="10" pad_ver="6"/>
        <style name="style_btn_accent" bg_color="#accent" text_color="#on_accent"/>
        <style name="style_btn_pressed" bg_color="#line"/>
        <style name="style_btn_accent_pressed" bg_color="0x1fa595"/>

        <!-- Chat bubbles -->
        <style name="style_bubble_in" text_color="#text" bg_color="#surface2" bg_opa="255" radius="10" border_width="0"
               pad_hor="8" pad_ver="5" pad_row="2"/>
        <style name="style_bubble_out" text_color="#text" bg_color="#bubble_out" bg_opa="255" radius="10" border_width="0"
               pad_hor="8" pad_ver="5" pad_row="2"/>

        <!-- Tab bar -->
        <style name="style_tabbar" bg_color="#surface" bg_opa="255" border_width="1" border_side="top"
               border_color="#line" pad_all="0" radius="0"/>
        <style name="style_tab_btn" bg_opa="0" text_color="#muted" text_font="font_small"
               border_width="0" radius="0" shadow_width="0" outline_width="0"/>
        <style name="style_tab_btn_checked" text_color="#accent" border_width="2" border_side="top"
               border_color="#accent" bg_opa="0"/>

        <!-- Problems: banner, alert badge, toasts -->
        <style name="style_banner" bg_opa="255" radius="0" border_width="0" pad_hor="8" pad_ver="4"
               pad_column="6" text_font="font_small" flex_cross_place="center" flex_track_place="center"/>
        <style name="style_alert_warn" bg_color="#warn" bg_opa="255" text_color="#bg"/>
        <style name="style_alert_err" bg_color="#danger" bg_opa="255" text_color="0xffffff"/>
        <style name="style_badge_btn" radius="9" pad_hor="6" pad_ver="0" border_width="0" shadow_width="0"/>
        <style name="style_toast" bg_color="#surface2" bg_opa="255" border_width="1" border_color="#line"
               radius="8" pad_hor="12" pad_ver="8" text_color="#text" text_font="font_small"/>
        <style name="style_toast_err" bg_color="#danger_bg" border_color="#danger"/>
        <style name="style_overlay" bg_color="#bg" bg_opa="240" border_width="0" radius="0"
               pad_all="16" pad_row="8" text_color="#text"/>

        <!-- Inputs -->
        <style name="style_textarea" bg_color="#surface2" bg_opa="255" border_width="1"
               border_color="#line" radius="6" text_color="#text" pad_hor="8" pad_ver="5"/>
        <style name="style_textarea_focused" border_color="#accent"/>
        <!-- Joystick / keypad cursor; the device adds it to every item it can focus. -->
        <style name="style_focus" outline_width="2" outline_color="#accent" outline_opa="255" outline_pad="1"/>
        <!-- The same inside the edge, where a parent clips (tab buttons) -->
        <style name="style_focus_inner" outline_width="2" outline_color="#accent" outline_opa="255" outline_pad="-3"/>
        <style name="style_track" bg_color="#surface2" bg_opa="255" radius="999" border_width="0"/>
        <style name="style_indicator" bg_color="#accent" bg_opa="255" radius="999"/>
        <style name="style_knob" bg_color="#text" bg_opa="255" radius="999" pad_all="2"/>
        <style name="style_dropdown" bg_color="#surface2" bg_opa="255" border_width="0" radius="6"
               text_color="#text" text_font="font_small" pad_hor="8" pad_ver="4"/>
        <style name="style_dropdown_list" bg_color="#surface2" bg_opa="255" border_width="1"
               border_color="#line" radius="6" text_color="#text" text_font="font_small"/>
        <style name="style_dropdown_sel" bg_color="#accent" bg_opa="255" text_color="#on_accent"/>
        <style name="style_keyboard" bg_color="#surface" bg_opa="255" border_width="0" pad_all="3"
               pad_row="3" pad_column="3" radius="0"/>
        <style name="style_keyboard_keys" bg_color="#surface2" text_color="#text" radius="4"
               border_width="0" shadow_width="0" text_font="font_small"/>
        <style name="style_keyboard_ctrl" bg_color="#line" text_color="#text"/>
        <style name="style_keyboard_sel" bg_color="#accent" bg_opa="255" text_color="#on_accent"/>
    </styles>

    <subjects>
        <!-- Node / device state (set from the MeshCore glue code on the device) -->
        <string name="node_name"    value="IT-Roma-Base"/>
        <string name="clock"        value="14:32"/>
        <int    name="battery_pct"  value="76" min_value="0" max_value="100"/>
        <int    name="last_rssi"    value="-92"/>
        <int    name="unread_total" value="3"/>
        <int    name="tx_power"     value="22" min_value="1" max_value="30"/>
        <string name="last_advert"  value="never"/>
        <string name="node_id"      value="Companion | a3f9c41e...7b02"/>
        <string name="radio_freq"   value="869.525 MHz"/>
        <string name="radio_bw"     value="250 kHz"/>
        <string name="radio_sf"     value="SF11"/>
        <string name="radio_cr"     value="4/5"/>
        <string name="contacts_summary" value="6 nodes | 3 companions | 2 repeaters | 1 room"/>

        <!-- Problems. level: 0 = none, 1 = warning, 2 = error. On the device these
             start empty; the values here are what the previewer shows. -->
        <int    name="alert_count"  value="3"/>
        <int    name="alert_level"  value="2"/>
        <string name="banner_text"  value="Radio not available: can't send or receive"/>
        <int    name="banner_level" value="2"/>
        <string name="toast_text"   value=""/>
        <int    name="toast_level"  value="0"/>

        <!-- Conversation screen -->
        <string name="chat_title"    value="Alice"/>
        <string name="chat_path"     value="Direct | 1 hop"/>
        <int    name="show_keyboard" value="0" min_value="0" max_value="1"/>

        <!-- Settings. The device loads these from NodePrefs when a settings screen
             opens; the values here are what the previewer shows. Dropdowns hold the
             selected index. -->
        <string name="set_name"         value="IT-Roma-Base"/>
        <string name="set_lat"          value="41.902800"/>
        <string name="set_lon"          value="12.496400"/>
        <int    name="set_share_loc"    value="1"/>
        <int    name="set_preset"       value="1"/>
        <string name="set_freq"         value="869.618 MHz"/>
        <int    name="set_bw"           value="6"/>
        <int    name="set_sf"           value="3"/>
        <int    name="set_cr"           value="3"/>
        <int    name="set_txp"          value="22" min_value="-9" max_value="22"/>
        <int    name="set_offgrid"      value="0"/>
        <int    name="set_aa_all"       value="1"/>
        <int    name="set_aa_chat"      value="1"/>
        <int    name="set_aa_rpt"       value="1"/>
        <int    name="set_aa_room"      value="1"/>
        <int    name="set_aa_sensor"    value="0"/>
        <int    name="set_aa_overwrite" value="0"/>
        <int    name="set_aa_maxhops"   value="0"/>
        <int    name="set_tel_base"     value="2"/>
        <int    name="set_tel_loc"      value="1"/>
        <int    name="set_tel_env"      value="1"/>
        <int    name="gps_on"           value="1"/>
        <string name="set_gps_interval" value="every 300 s"/>
        <int    name="set_timesync"     value="1"/>
        <int    name="set_tz"           value="13"/>
        <int    name="set_buzzer"       value="1"/>
        <int    name="set_leds"         value="1"/>
        <int    name="ble_on"           value="1"/>
        <string name="set_pin"          value="123456"/>
        <int    name="set_multi_acks"   value="0"/>
        <int    name="set_path_hash"    value="0"/>
        <string name="set_rx_delay"     value="0.000"/>
        <string name="set_airtime"      value="1.000"/>

        <!-- One-line summaries on the Settings menu -->
        <string name="sum_public"    value="IT-Roma-Base | location shared"/>
        <string name="sum_radio"     value="869.618 MHz | 62.5 kHz | SF8 | 22 dBm"/>
        <string name="sum_contacts"  value="Add every node"/>
        <string name="sum_telemetry" value="Base: everyone | location, sensors: allowed"/>
        <string name="sum_location"  value="GPS on | UTC+1"/>
        <string name="sum_device"    value="Buzzer on | LEDs on"/>
        <string name="sum_bluetooth" value="On | PIN 123456"/>
        <string name="sum_advanced"  value="1-byte path hash | single ACKs"/>

        <!-- Contacts tab: 0 all, 1 companions, 2 repeaters, 3 rooms, 4 sensors -->
        <int    name="contacts_filter" value="0"/>

        <!-- Remote management -->
        <string name="remote_name"         value="Monte Cavo"/>
        <string name="remote_role"         value="Repeater | admin"/>
        <string name="remote_pwd_txt"      value="not set"/>
        <string name="remote_result_title" value="STATUS"/>
        <string name="remote_state"        value="just now"/>
        <string name="rs_state" value="Tap a value to change it."/>
        <string name="rs_name"  value="Monte Cavo"/>
        <string name="rs_lat"   value="41.746200"/>
        <string name="rs_lon"   value="12.704100"/>
        <string name="rs_radio" value="869.618,62.5,8,8"/>
        <string name="rs_tx"    value="22"/>
        <string name="rs_repeat" value="on"/>
        <string name="rs_adv"   value="120"/>
        <string name="rs_fadv"  value="12"/>
        <string name="rs_owner" value="IW0ABC"/>
        <string name="rs_guest" value=""/>
        <string name="rs_admin" value="change"/>
        <string name="sum_sensors" value="Battery 4.12 V | 3 readings"/>

        <!-- Map -->
        <string name="map_status"     value="6 nodes with a position | 3.2 km scale"/>
        <string name="map_attrib"     value=""/>
        <string name="map_sel_name"   value="Monte Cavo"/>
        <string name="map_sel_info"   value="Repeater | 21.4 km | heard 1m ago"/>
        <string name="map_sel_action" value="Manage"/>

        <!-- Edit panel -->
        <string name="edit_title" value="Name"/>
        <string name="edit_hint"  value="Up to 31 characters"/>
    </subjects>

    <images>
    </images>

    <fonts>
        <bin name="font_small" src_path="fonts/Montserrat-Medium.ttf" size="12" bpp="4" as_file="false"/>
        <bin name="font_body"  src_path="fonts/Montserrat-Medium.ttf" size="14" bpp="4" as_file="false"/>
        <bin name="font_title" src_path="fonts/Montserrat-Bold.ttf"   size="16" bpp="4" as_file="false"/>
        <bin name="font_big"   src_path="fonts/Montserrat-Bold.ttf"   size="22" bpp="4" as_file="false"/>
    </fonts>
</globals>
