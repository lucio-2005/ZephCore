<!-- Main screen: status bar on top, four tabs with the tab bar at the bottom.
     Permanent, so it keeps its state (active tab, scroll position) when a conversation is opened. -->
<screen permanent="true">
    <view flex_flow="column" scrollable="false">
        <style name="style_screen"/>
        <!-- Back from a settings screen: refresh the menu summaries. -->
        <event_cb trigger="screen_load_start" callback="ui_on_settings_open" user_data="menu"/>

        <status_bar/>

        <!-- Ongoing problem (radio down, ...). Hidden when banner_level is 0. -->
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false">
            <style name="style_banner"/>
            <style name="style_alert_warn"/>
            <bind_style name="style_alert_err" subject="banner_level" ref_value="2"/>
            <bind_flag_if_eq subject="banner_level" flag="hidden" ref_value="0"/>
            <screen_create_event trigger="clicked" screen="alerts" anim_type="move_left" duration="200"/>
            <lv_label bind_text="banner_text" flex_grow="1"/>
            <lv_label text="Details &gt;"/>
        </lv_obj>

        <lv_tabview width="100%" flex_grow="1" tab_bar_position="bottom" active="0">
            <style name="style_plain"/>

            <!-- ============ CHATS ============ -->
            <lv_tabview-tab text="Chats" name="chat_list" flex_flow="column">
                <style name="style_page"/>
                <chat_row title="Public" letter="P" tint="#kind_channel" path="Channel | flood"
                          preview="Marco: anyone on 869.525 tonight?" when="14:28" unread="2" is_read="false"/>
                <chat_row title="Alice" letter="A" tint="#kind_chat" path="Direct | 1 hop"
                          preview="See you at the field day!" when="14:07" unread="1" is_read="false"/>
                <chat_row title="Roma Mesh" letter="R" tint="#kind_channel" path="Channel | flood"
                          preview="Luca: Monte Cavo repeater is back up" when="13:55"/>
                <chat_row title="Bob" letter="B" tint="#kind_chat" path="Direct | 3 hops"
                          preview="You: ok, sending a flood advert now" when="Yesterday"/>
                <chat_row title="Giulia" letter="G" tint="#kind_chat" path="Direct | 4 hops"
                          preview="Thanks for the path test" when="Mon"/>
            </lv_tabview-tab>

            <!-- ============ CONTACTS ============ -->
            <lv_tabview-tab text="Contacts" flex_flow="column">
                <style name="style_page"/>
                <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                        style_flex_cross_place="center">
                    <style name="style_plain"/>
                    <lv_label bind_text="contacts_summary" flex_grow="1" height="15" long_mode="dots">
                        <style name="style_text_muted"/>
                    </lv_label>
                    <mc_dropdown subject="contacts_filter" options="All&#10;Companions&#10;Repeaters&#10;Rooms&#10;Sensors"
                                 width="116"/>
                </lv_obj>
                <lv_obj name="contact_list" width="100%" height="content" flex_flow="column" scrollable="false"
                        style_pad_row="#gap_m">
                    <style name="style_plain"/>
                    <contact_row name="Monte Cavo" letter="M" kind="RPT" tint="#kind_rpt"
                                 heard="heard 1m ago" hops="Direct" snr="SNR 11.0"/>
                    <contact_row name="Alice" letter="A" kind="CHAT" tint="#kind_chat"
                                 heard="heard 2m ago" hops="1 hop" snr="SNR 9.2"/>
                    <contact_row name="Bob" letter="B" kind="CHAT" tint="#kind_chat"
                                 heard="heard 15m ago" hops="3 hops" snr="SNR 4.5"/>
                    <contact_row name="Roma-Nord" letter="R" kind="RPT" tint="#kind_rpt"
                                 heard="heard 22m ago" hops="2 hops" snr="SNR -3.5"/>
                    <contact_row name="IT Mesh Room" letter="I" kind="ROOM" tint="#kind_room"
                                 heard="heard 1h ago" hops="3 hops" snr="SNR 1.0"/>
                    <contact_row name="Giulia" letter="G" kind="CHAT" tint="#kind_chat"
                                 heard="heard 3h ago" hops="4 hops" snr="SNR -6.0"/>
                    <contact_row name="Garden" letter="G" kind="SENSOR" tint="#kind_sensor"
                                 heard="heard 5h ago" hops="2 hops" snr=""/>
                </lv_obj>
            </lv_tabview-tab>

            <!-- ============ NODE ============ -->
            <lv_tabview-tab text="Node" flex_flow="column">
                <style name="style_page"/>

                <lv_obj width="100%" height="content" flex_flow="column" scrollable="false">
                    <style name="style_card"/>
                    <lv_label bind_text="node_name" style_text_font="font_big"/>
                    <lv_label bind_text="node_id">
                        <style name="style_text_muted"/>
                    </lv_label>
                    <lv_obj width="100%" height="content" flex_flow="row" scrollable="false"
                            style_flex_cross_place="center" style_pad_column="8">
                        <style name="style_plain"/>
                        <lv_label text="Battery">
                            <style name="style_text_muted"/>
                        </lv_label>
                        <lv_bar flex_grow="1" height="8" bind_value="battery_pct">
                            <style name="style_track"/>
                            <style name="style_indicator" selector="indicator"/>
                        </lv_bar>
                        <lv_label bind_text="battery_pct" bind_text-fmt="%d%%"/>
                    </lv_obj>
                </lv_obj>

                <section_label text="RADIO"/>
                <lv_obj width="100%" height="content" flex_flow="column" scrollable="false">
                    <style name="style_card"/>
                    <kv_row key="Frequency" value="radio_freq"/>
                    <kv_row key="Bandwidth" value="radio_bw"/>
                    <kv_row key="Spreading factor" value="radio_sf"/>
                    <kv_row key="Coding rate" value="radio_cr"/>
                    <lv_obj width="100%" height="content" flex_flow="row" scrollable="false"
                            style_flex_cross_place="center">
                        <style name="style_plain"/>
                        <lv_label text="TX power" flex_grow="1">
                            <style name="style_text_muted"/>
                        </lv_label>
                        <lv_label bind_text="tx_power" bind_text-fmt="%d dBm"/>
                    </lv_obj>
                    <lv_label bind_text="last_rssi" bind_text-fmt="Last packet RSSI: %d dBm">
                        <style name="style_text_muted"/>
                    </lv_label>
                </lv_obj>

                <nav_row title="Sensors" summary="sum_sensors">
                    <screen_create_event trigger="clicked" screen="sensors" anim_type="move_left" duration="200"/>
                </nav_row>

                <section_label text="ADVERTISE"/>
                <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" style_pad_column="6">
                    <style name="style_plain"/>
                    <lv_button flex_grow="1" height="content">
                        <style name="style_btn"/>
                        <style name="style_btn_pressed" selector="pressed"/>
                        <subject_set_string_event trigger="clicked" subject="last_advert" value="zero-hop at 14:32"/>
                        <event_cb trigger="clicked" callback="ui_on_advert_zerohop"/>
                        <lv_label text="Zero-hop" align="center"/>
                    </lv_button>
                    <lv_button flex_grow="1" height="content">
                        <style name="style_btn"/>
                        <style name="style_btn_accent"/>
                        <style name="style_btn_accent_pressed" selector="pressed"/>
                        <subject_set_string_event trigger="clicked" subject="last_advert" value="flood at 14:32"/>
                        <event_cb trigger="clicked" callback="ui_on_advert_flood"/>
                        <lv_label text="Flood" align="center"/>
                    </lv_button>
                </lv_obj>
                <lv_label bind_text="last_advert" bind_text-fmt="Last advert: %s">
                    <style name="style_text_muted"/>
                </lv_label>
            </lv_tabview-tab>

            <!-- ============ SETTINGS ============ -->
            <lv_tabview-tab text="Settings" flex_flow="column">
                <style name="style_page"/>
                <!-- The same settings the MeshCore app offers, plus device-only ones. -->
                <nav_row name="nav_public" title="Public info" summary="sum_public">
                    <screen_create_event trigger="clicked" screen="settings_public" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_radio" title="Radio" summary="sum_radio">
                    <screen_create_event trigger="clicked" screen="settings_radio" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_contacts" title="Contacts" summary="sum_contacts">
                    <screen_create_event trigger="clicked" screen="settings_contacts" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_telemetry" title="Telemetry" summary="sum_telemetry">
                    <screen_create_event trigger="clicked" screen="settings_telemetry" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_location" title="Location and time" summary="sum_location">
                    <screen_create_event trigger="clicked" screen="settings_location" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_bluetooth" title="Bluetooth" summary="sum_bluetooth">
                    <screen_create_event trigger="clicked" screen="settings_bluetooth" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_device" title="Device" summary="sum_device">
                    <screen_create_event trigger="clicked" screen="settings_device" anim_type="move_left" duration="200"/>
                </nav_row>
                <nav_row name="nav_advanced" title="Advanced" summary="sum_advanced">
                    <screen_create_event trigger="clicked" screen="settings_advanced" anim_type="move_left" duration="200"/>
                </nav_row>
            </lv_tabview-tab>

            <!-- Tab bar styling (must come after the tabs so the buttons exist) -->
            <lv_tabview-tab_bar height="30">
                <style name="style_tabbar"/>
            </lv_tabview-tab_bar>
            <lv_tabview-tab_button index="0">
                <style name="style_tab_btn"/>
                <style name="style_tab_btn_checked" selector="checked"/>
            </lv_tabview-tab_button>
            <lv_tabview-tab_button index="1">
                <style name="style_tab_btn"/>
                <style name="style_tab_btn_checked" selector="checked"/>
            </lv_tabview-tab_button>
            <lv_tabview-tab_button index="2">
                <style name="style_tab_btn"/>
                <style name="style_tab_btn_checked" selector="checked"/>
            </lv_tabview-tab_button>
            <lv_tabview-tab_button index="3">
                <style name="style_tab_btn"/>
                <style name="style_tab_btn_checked" selector="checked"/>
            </lv_tabview-tab_button>
        </lv_tabview>
    </view>
</screen>
