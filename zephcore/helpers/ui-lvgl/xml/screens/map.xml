<!-- Map of this node and the contacts whose adverts carry a position (the
     Contacts tab's filter applies). Drag to pan; tap a node for details. The
     device draws the map area (ui_lvgl_map.c): offline tiles when there are
     any, a scale and range rings otherwise. -->
<screen>
    <view flex_flow="column" scrollable="false">
        <style name="style_screen"/>
        <event_cb trigger="screen_load_start" callback="ui_on_map_open"/>

        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
                style_pad_ver="4" style_pad_left="4" style_pad_column="4">
            <style name="style_statusbar"/>
            <lv_button name="nav_back" width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <screen_load_event trigger="clicked" screen="home" anim_type="move_right" duration="200"/>
                <lv_label text="&lt; Back" style_text_font="font_small"/>
            </lv_button>
            <lv_obj flex_grow="1" height="content" flex_flow="column" scrollable="false" clickable="false">
                <style name="style_plain"/>
                <lv_label text="Map">
                    <style name="style_title"/>
                </lv_label>
                <lv_label bind_text="map_status" width="100%" height="15" long_mode="dots">
                    <style name="style_text_muted"/>
                </lv_label>
            </lv_obj>
            <lv_button width="34" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_map_zoom" user_data="out"/>
                <lv_label text="-" align="center"/>
            </lv_button>
            <lv_button width="34" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_map_zoom" user_data="in"/>
                <lv_label text="+" align="center"/>
            </lv_button>
            <lv_button width="content" height="content">
                <style name="style_btn"/>
                <style name="style_btn_pressed" selector="pressed"/>
                <event_cb trigger="clicked" callback="ui_on_map_zoom" user_data="fit"/>
                <lv_label text="All" style_text_font="font_small"/>
            </lv_button>
        </lv_obj>

        <lv_obj name="map_area" width="100%" flex_grow="1" scrollable="false" style_bg_color="#map_bg"
                style_bg_opa="255" style_border_width="0" style_radius="0" style_pad_all="0">
            <lv_label name="map_attrib" bind_text="map_attrib" align="bottom_right" style_text_font="font_small"
                      style_text_color="#muted" style_bg_color="#bg" style_bg_opa="160" style_pad_hor="3"/>

            <!-- Details of the node tapped; hidden until then. -->
            <lv_obj name="map_card" width="94%" height="content" align="top_mid" y="6" flex_flow="row"
                    scrollable="false" style_flex_cross_place="center">
                <style name="style_card"/>
                <lv_obj flex_grow="1" height="content" flex_flow="column" scrollable="false" clickable="false">
                    <style name="style_plain"/>
                    <lv_label bind_text="map_sel_name" width="100%" height="20" long_mode="dots">
                        <style name="style_title"/>
                    </lv_label>
                    <lv_label bind_text="map_sel_info" width="100%" height="15" long_mode="dots">
                        <style name="style_text_muted"/>
                    </lv_label>
                </lv_obj>
                <lv_button name="map_open" width="content" height="content">
                    <style name="style_btn"/>
                    <style name="style_btn_accent"/>
                    <style name="style_btn_accent_pressed" selector="pressed"/>
                    <event_cb trigger="clicked" callback="ui_on_map_open_node"/>
                    <lv_label bind_text="map_sel_action" style_text_font="font_small"/>
                </lv_button>
            </lv_obj>
        </lv_obj>
    </view>
</screen>
