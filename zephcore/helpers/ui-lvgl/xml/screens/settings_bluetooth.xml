<!-- Settings: Bluetooth. Values are loaded when the screen opens (ui_on_settings_open). -->
<screen>
    <view flex_flow="column" scrollable="false">
        <style name="style_screen"/>
        <event_cb trigger="screen_load_start" callback="ui_on_settings_open" user_data="bluetooth"/>
        <sub_header title="Bluetooth"></sub_header>
        <lv_obj width="100%" flex_grow="1" flex_flow="column" scrollbar_mode="auto">
            <style name="style_page"/>
            <setting_row label="Bluetooth" hint="Companion app connection">
                <mc_switch subject="ble_on"/>
            </setting_row>
            <value_row label="Pairing PIN" value="set_pin" key="pin"/>
            <lv_label text="PIN 0 picks a random PIN shown at pairing." width="100%">
                <style name="style_text_muted"/>
            </lv_label>
        </lv_obj>
    </view>
</screen>
