<!-- Settings: Contacts. Values are loaded when the screen opens (ui_on_settings_open). -->
<screen>
    <view flex_flow="column" scrollable="false">
        <style name="style_screen"/>
        <event_cb trigger="screen_load_start" callback="ui_on_settings_open" user_data="contacts"/>
        <sub_header title="Contacts"></sub_header>
        <lv_obj width="100%" flex_grow="1" flex_flow="column" scrollbar_mode="auto">
            <style name="style_page"/>
            <setting_row label="Add every node" hint="Off: only the types below">
                <mc_switch subject="set_aa_all"/>
            </setting_row>
            <section_label text="WHEN NOT ADDING EVERY NODE"/>
            <setting_row label="Companions" hint="Chat nodes">
                <mc_switch subject="set_aa_chat"/>
            </setting_row>
            <setting_row label="Repeaters" hint="">
                <mc_switch subject="set_aa_rpt"/>
            </setting_row>
            <setting_row label="Room servers" hint="">
                <mc_switch subject="set_aa_room"/>
            </setting_row>
            <setting_row label="Sensors" hint="">
                <mc_switch subject="set_aa_sensor"/>
            </setting_row>
            <section_label text="ALWAYS"/>
            <setting_row label="Replace oldest" hint="When the contact list is full">
                <mc_switch subject="set_aa_overwrite"/>
            </setting_row>
            <setting_row label="Max distance" hint="Only add nodes this close">
                <mc_dropdown subject="set_aa_maxhops" options="No limit&#10;Direct only&#10;1 hop&#10;2 hops&#10;3 hops&#10;4 hops&#10;5 hops&#10;6 hops&#10;7 hops"/>
            </setting_row>
        </lv_obj>
    </view>
</screen>
